{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ce-desktop-tools",
  "version": "1.0.10",
  "identifier": "com.ce.desktop-tools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ce-desktop-tools",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "devtools": true,
        "dataDirectory": "webview"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QkM1Q0NFNDI0MTI0QjgKUldTNEpFRkN6bHk4cUk4d0hsR3F2OStpRXpneTRMQ2pMaDRrV3Y4WXVMdDMvQWVqZ3JGdVcvTHQK",
      "endpoints": [
        "https://github.com/CHE-11/ce-desktop-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
